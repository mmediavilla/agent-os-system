APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Signing in — Google, and only the owner. Every route but sign-in, /api/health
# and /api/mcp needs a token now; `php artisan auth:token` mints one for scripts.
#
# The client is a Google Cloud OAuth client of type Web. Its authorised redirect
# URI must be exactly GOOGLE_REDIRECT_URI: localhost, because Google refuses
# `.test` addresses, and Expo's dev server (already on 8082) forwards the code
# from there to https://projectmc-app.test. Leave the consent screen in Testing
# with only the owner as a test user — a third lock, on Google's side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8082/auth/callback
# The one Google account allowed in. Blank means nobody, not everybody. The first
# sign-in also pins the account's Google id, so a recycled address cannot get in.
AUTH_OWNER_EMAIL=
# How long a sign-in lasts, counted from when it was made.
AUTH_TOKEN_DAYS=30

# Anthropic / Claude API — required for AI insight generation.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_AGENT_MODEL=claude-sonnet-5
ANTHROPIC_AGENT_MAX_TOKENS=8192
ANTHROPIC_EFFORT=high

# The MCP host's credential (POST /api/mcp only) — the route 503s without it.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
AGENT_API_TOKEN=
AGENT_RATE_LIMIT=30
# Model calls one chat message may cost before the loop is made to answer.
AGENT_MAX_ITERATIONS=12
# Browser origin for the future desktop shell. Leave blank until one exists.
AGENT_ALLOWED_ORIGIN=

# The clock the user lives on. app.timezone is UTC and stays UTC (timestamps are
# stored in it), which is the wrong answer to "what day is it" for a server that
# runs hours away from the person using it — the assistant's "Today is …" and the
# nudge's schedule both read this. PROACTIVE_TIMEZONE is the older spelling and
# is still honoured as the fallback.
AGENT_TIMEZONE=UTC

# Proactive nudges — the one scheduled thing in the app. The trigger check is
# free and runs daily; the model is called only when something actually fires.
PROACTIVE_INSIGHTS_ENABLED=true
PROACTIVE_TIME=07:00
PROACTIVE_TIMEZONE=UTC

# Reaching this machine — open_on_this_machine opens a folder, file, app or page
# on the computer serving this app, and only the ones listed in config/agent.php.
# Off by default: while it is off the tool is not registered at all, so nothing
# advertises a reach into a machine that has not granted one. Leaving
# LOCAL_ACTIONS_EDITOR unset simply drops that one entry from the list.
# The same switch offers the spoken assistant show_google_calendar, which opens
# Google Calendar in a new tab of the default browser — nothing to configure.
LOCAL_ACTIONS_ENABLED=false
LOCAL_ACTIONS_EDITOR=
APP_WEB_URL=https://projectmc-app.test

# The spoken conversation — POST /api/voice/turn, which an ElevenLabs client
# tool calls with whatever was said, and GET /api/voice/token, which is how the
# page is allowed to open the session without holding the key.
#
# The key stays here and never becomes an EXPO_PUBLIC_* value: Expo inlines
# every one of those into the web bundle. Left blank, pressing Talk says which
# line to set, and typing is unaffected.
ELEVENLABS_API_KEY=
#
# The ceiling is its own rather than `agent`'s. A voice turn
# spends what a typed message spends, because it is the same loop — but sharing
# the chat's bucket would let a spoken question cost a typed one its slot, and
# both are used in the same thread by the same person.
VOICE_RATE_LIMIT=20
#
# The agent itself is made in the ElevenLabs dashboard — Agents, Create agent,
# Blank — and everything about it that is not a secret is a setting over there:
# a small router LLM (Haiku 4.5 or Flash Lite, not Sonnet, since the reasoning
# happens in our loop), a system prompt that forbids it answering from its own
# knowledge, an empty first message, and one **client** tool `ask_life_os` with
# a required string `question`, Wait for response ON. Turn pre-tool speech on
# with a ~3s soft timeout — that is the single setting that decides whether the
# wait for our loop feels alive or dead. The voice and the TTS model are chosen
# there too.
#
# There is no always-on: a session bills by the minute whether or not anyone
# speaks, so an idle one is hung up by two settings on the agent, not by code
# here. Set turn.silence_end_call_timeout (~30s since the user last spoke; the
# default, -1, never hangs up) and conversation.max_duration_seconds (~300).
#
# The key above needs **convai_write** on it. A key with
# only the text-to-speech scopes authenticates perfectly and is refused here,
# which looks like a broken feature rather than a missing permission.
ELEVENLABS_AGENT_ID=

# The weather — the HUD's button and the assistant's get_weather. No account and
# no key — Open-Meteo needs neither — but it does need to be told where you are:
# there is no sensible default, and nothing is guessed from an IP address. Left
# blank the card says it is not configured, which is a state it is designed for
# rather than an error; the assistant can still read a place you name.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LABEL=

# Calendars — Google, iCloud, anything with an iCal address. The addresses are
# not here: each is pasted into Settings → Calendars and stored encrypted, so
# none of these is needed to start. They tune how often a feed is fetched (each
# at most once per TTL, and a failure remembered so an outage is not a retry
# loop), how long one fetch may take, and how far either side of today is read.
# A feed is parsed at ~40MB per MB of text, so the span is what keeps a decade
# of calendar inside the memory limit; a day outside it is unknown, never free.
CALENDAR_TTL=300
CALENDAR_FAILURE_TTL=60
CALENDAR_TIMEOUT=8
CALENDAR_PAST_DAYS=365
CALENDAR_FUTURE_DAYS=365

# How long a machine sample counts as current before GET /api/system/stats
# queues another. The probe costs about half a second on Windows and never runs
# inside a request — see config/hud.php.
HUD_SAMPLE_TTL=10
# How stale a heartbeat may be before the queue worker or the scheduler is
# reported down. Generous, because the tick is once a minute and the worker
# sleeps between polls.
HUD_HEARTBEAT_GRACE=150

# How big a filed document may be, in kilobytes — 20MB by default. A scanned
# passport is a couple of megabytes and a photographed contract can be ten, and
# nothing downscales one on the way in, so this is generous where the camera
# frame's limit is mean. Over it is a 413 rather than a silent resize. Keep it
# under PHP's own upload_max_filesize and post_max_size, or a file over those
# never reaches Laravel and the answer is a confusing "no file" instead.
DOCUMENTS_MAX_KB=20480
